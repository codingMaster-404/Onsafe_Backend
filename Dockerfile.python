FROM python:3.12-slim

WORKDIR /app

# 의존성 레이어 캐싱 — 소스 변경 시 pip install 재실행 방지
COPY requirements.txt .

# xgboost가 무조건 끌고 오는 nvidia-nccl(멀티-GPU 전용, ~240MB)과
# firebase-admin이 끌고 오는 googleapiclient의 정적 API discovery JSON(~99MB)은
# CPU 전용 추론 + Firestore/Storage만 쓰는 이 서비스에서 실행 경로상 전혀 참조되지 않음
# (predict_proba/firestore_async/storage 호출로 검증 완료) — 같은 레이어에서 제거해 이미지에 안 남도록 함
RUN pip install --no-cache-dir -r requirements.txt \
    && rm -rf /usr/local/lib/python3.12/site-packages/nvidia \
              /usr/local/lib/python3.12/site-packages/nvidia_* \
              /usr/local/lib/python3.12/site-packages/googleapiclient/discovery_cache/documents

COPY app/ ./app/
COPY pkl/ ./pkl/

# serviceAccountKey.json 은 docker-compose volume 으로 주입 (이미지에 포함 금지)

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
